# Base URL of your Immich instance
IMMICH_URL=http://192.168.1.100:2283

# API key from Immich (Account Settings → API Keys → New API Key)
IMMICH_API_KEY=your-api-key-here

# PIN code for the Locked folder (optional — leave empty to skip locked assets)
# Accessing the locked folder requires a session token, so email + password
# are also needed in addition to the PIN.
# IMMICH_EMAIL=your-email@example.com
# IMMICH_PASSWORD=your-password
# IMMICH_PIN=123456